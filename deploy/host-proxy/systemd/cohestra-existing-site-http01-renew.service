[Unit]
Description=Renew thesocialcollectivesg.com HTTP-01 lineage only
Documentation=file:///home/deploy/cohestra/deploy/host-proxy/README.md
After=docker.service
Requires=docker.service
OnFailure=cohestra-existing-site-http01-renew-alert.service

[Service]
Type=oneshot
User=deploy
Group=docker
Environment=COHESTRA_AUTHORIZE_EXISTING_RENEW=1
ExecStart=/home/deploy/cohestra/deploy/host-proxy/renew-existing-site-http01.sh
# System unit: survives logout and reboot. Do not use a user timer.
# Install only with owner authorization. Existing-site lineage only.
