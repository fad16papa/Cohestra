# Copy to .env when another product already uses 5432 / 6379 / 80 on your machine.
#   cp .env.local-docker.example .env
#
# === Hosts file (required for marketing + tenant URLs) ===
# Windows: C:\Windows\System32\drivers\etc\hosts
#   127.0.0.1 cohestra.app
#   127.0.0.1 creativorare.localhost
#   127.0.0.1 default.localhost
#
# === Full update after git pull (run from repo root) ===
#   git fetch origin
#   git checkout main
#   git pull origin main
#   docker compose build web --no-cache
#   docker compose up -d web nginx api
#
# === URLs (port 8088) ===
#   Product marketing landing:  http://cohestra.app:8088/
#   Marketing login:            http://cohestra.app:8088/login
#   Tenant homepage (UAT):      http://creativorare.localhost:8088/
#   Website builder:            http://creativorare.localhost:8088/dashboard/website
#   Platform admin:             http://localhost:8088/platform
#   Default tenant stub ONLY:   http://localhost:8088/  (Basic plan — not marketing)
#
# NEVER run: docker compose down -v   (wipes Postgres — all tenant data lost)

PUBLIC_BASE_URL=http://localhost:8088
NGINX_HTTP_PORT=8088
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380

POSTGRES_DB=cohestra
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm

# Optional: demo seed data (Development only — curated personas, merge suspects, etc.)
# DemoDataSeed__Enabled=true
# DemoDataSeed__ClientCount=48

# Optional: load-test workspaces (login on tenant subdomain, not bare localhost)
# Add to hosts: 127.0.0.1 load-core-alpha.localhost load-pro-beta.localhost
# LoadTestSeed__Enabled=true
# LoadTestSeed__ForceReseed=true
# LoadTestSeed__Password=LoadTest123!
# Then: http://load-core-alpha.localhost:8088/login
