# Copy to .env when another product already uses 5432 / 6379 / 80 on your machine.
#   cp .env.local-docker.example .env
#
# IMPORTANT: Without copying this file to .env, OperatorSeed and LoadTestSeed stay OFF
# and login accounts will not exist (401 Invalid email or password).
# === Hosts file (required for marketing + tenant URLs) ===
# Windows: C:\Windows\System32\drivers\etc\hosts
#   127.0.0.1 cohestra.app
#   127.0.0.1 creativorare.localhost
#   127.0.0.1 default.localhost
#   127.0.0.1 load-core-alpha.localhost
#   127.0.0.1 load-core-beta.localhost
#   127.0.0.1 load-pro-alpha.localhost
#   127.0.0.1 load-pro-beta.localhost
#   127.0.0.1 load-basic-alpha.localhost
#
# === Full update after git pull (run from repo root) ===
#   git fetch origin
#   git checkout main
#   git pull origin main
#   docker compose build web api --no-cache
#   docker compose up -d --force-recreate api web nginx
#
# IMPORTANT: Changing seed flags in .env requires --force-recreate api (not just up -d).
# Check seed ran: docker compose logs api | grep -i seed
#
# === Seed data — WHERE to look ===
# Demo seed (DemoDataSeed__Enabled) → default tenant ONLY:
#   Login:    http://default.localhost:8088/login  (operator@cohestra.local / ChangeMe123!)
#   Clients:  http://default.localhost:8088/clients  (Francis Decena, merge suspects, etc.)
# Load test seed (LoadTestSeed__Enabled) → load-* tenants (runs in BACKGROUND after API is up):
#   Login:    http://localhost:8088/login OR http://load-core-alpha.localhost:8088/login
#             (load.core.alpha@cohestra.local / LoadTest123!)
#   Progress: docker compose logs -f api | grep -i "load test"
# creativorare.localhost is NOT auto-seeded — use default or load-* tenants above.
#
# === URLs (port 8088) ===
#   Product marketing landing:  http://cohestra.app:8088/
#   Marketing login:            http://cohestra.app:8088/login
#   Tenant homepage (UAT):      http://creativorare.localhost:8088/
#   Website builder:            http://creativorare.localhost:8088/dashboard/website
#   Platform admin:             http://localhost:8088/platform
#   Default tenant stub ONLY:   http://localhost:8088/  (Basic plan — not marketing)
#
# NEVER run: docker compose down -v   (wipes Postgres — all tenant data lost)

PUBLIC_BASE_URL=http://localhost:8088
NGINX_HTTP_PORT=8088
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380

# Bind bare http://localhost:8088 to the default tenant (operator demo login without subdomain redirect).
DEV_TENANT_SLUG=default

POSTGRES_DB=cohestra
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm

# --- Seed flags (Development only) ---
OperatorSeed__Enabled=true
DemoDataSeed__Enabled=true
LoadTestSeed__Enabled=true
LoadTestSeed__ForceReseed=true
LoadTestSeed__Password=LoadTest123!

# Optional overrides:
# DemoDataSeed__ClientCount=48
# OperatorSeed__Email=operator@cohestra.local
# OperatorSeed__Password=ChangeMe123!
