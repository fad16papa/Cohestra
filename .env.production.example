# Cohestra Production environment — NAMES ONLY.
# Copy to the Production host as `.env` and fill values there.
# Never commit `.env`. Never put credentials, generated secrets, or owner data in this file.
#
# Compose project: cohestra-production
# Compose file:    docker-compose.production.yml
# Dedicated droplet only. UAT shared host is forbidden.
# PRODUCTION=NO-GO until the owner writes PRODUCTION CUTOVER: AUTHORIZED.

# =============================================================================
# runtime
# =============================================================================
# ASPNETCORE_ENVIRONMENT          (locked to Production in compose)
# Cohestra__DeploymentPlane       (locked to Production in compose)
# LANDING_SITE_NAME
# LANDING_TAGLINE
# LANDING_DESCRIPTION
# LANDING_EYEBROW
# LANDING_OPERATOR_CTA
# EmailBranding__WebsiteUrl
# EmailBranding__FooterLegalName
#
# Do not set DEV_TENANT_SLUG.
# Do not set Tenancy__DevTenantSlug.
# Do not set COHESTRA_SHARED_HOST_UAT=true.
# Do not reuse UAT JWT, Postgres, Redis, SendGrid, or Paddle values.
# PUBLIC_BASE_URL must be https://cohestra.app (not uat.*, not localhost, not http).
# CORS allows https://cohestra.app and https://{tenant}.cohestra.app only.
# OperatorSeed__Enabled, PlatformAdminSeed__Enabled, DemoDataSeed__Enabled,
# LoadTestSeed__Enabled, FollowUpDigest__Enabled are locked false in compose.

# =============================================================================
# database (OPTION A — self-hosted PostgreSQL 16)
# =============================================================================
# POSTGRES_DB
# POSTGRES_USER
# POSTGRES_PASSWORD

# =============================================================================
# redis
# =============================================================================
# REDIS_PASSWORD                  (required; UAT Redis stays passwordless)

# =============================================================================
# JWT / auth
# =============================================================================
# JWT_SIGNING_KEY                 (min 32 chars)
# JWT_ISSUER
# JWT_AUDIENCE

# =============================================================================
# Paddle (live credentials are a later owner gate — Story 46.10)
# =============================================================================
# Paddle__ApiKey
# Paddle__ClientToken
# Paddle__WebhookSecret
# Paddle__Environment             (locked sandbox in compose)
# Paddle__AllowLive               (locked false in compose)
# Paddle__PriceCoreMonthly
# Paddle__PriceCoreAnnual
# Paddle__PriceProMonthly
# Paddle__PriceProAnnual
# Paddle__TrialPeriodDays
# NEXT_PUBLIC_PADDLE_RETURN_ORIGIN

# =============================================================================
# SendGrid
# =============================================================================
# SendGrid__ApiKey
# SendGrid__FromEmail
# SendGrid__FromName
# SendGrid__RegistrationFromEmail
# SendGrid__RegistrationFromName
# SendGrid__UseSandbox            (locked false in compose)

# =============================================================================
# reCAPTCHA
# =============================================================================
# SelfServeSignup__Recaptcha__Enabled
# SelfServeSignup__Recaptcha__SecretKey
# NEXT_PUBLIC_RECAPTCHA_ENABLED
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY
# SelfServeSignup__RegistrationClosed
# PublicSignupRateLimit__MaxSuccessfulPerHour
# PublicSignupRateLimit__MaxSuccessfulPerDay
#
# Do not set SelfServeSignup__Recaptcha__TestBypassToken
# Do not set NEXT_PUBLIC_RECAPTCHA_TEST_TOKEN

# =============================================================================
# telemetry
# =============================================================================
# OTEL_EXPORTER_OTLP_ENDPOINT     (compose default: http://otelcol:4318)
# App SDK / dashboards / alerts: Stories 46.6 / 46.7 — not this file's job.

# =============================================================================
# public URLs
# =============================================================================
# PUBLIC_BASE_URL                 (https://cohestra.app — DNS cutover is 46.13 / 46.15)
# Owner host procedure: docs/deploy/production-runtime-secrets.md
# Never create this file as a committed Production .env. Names only.

# =============================================================================
# deployment / version
# =============================================================================
# GIT_SHA                         (inject at deploy; Story 46.3)
# GitHub Environment production secrets (PROD_DROPLET_*) belong to Story 46.3.
# Do not put SSH keys, droplet host names, or GitHub Environment secrets in the
# Production host application .env.
