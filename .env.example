# Environment variables for docker compose (copy to .env for local overrides)
#
# Docker Compose project name is set in docker-compose.yml as "cohestra-infra"
# (containers: cohestra-infra-api-1, volumes: cohestra-infra_postgres_data, etc.).
# Cohestra is independent from the single-operator lead-generation-crm product.
# If both run locally, use non-default host ports below to avoid conflicts.

# Public URL — must match what you type in the browser (nginx routes / and /api/)
PUBLIC_BASE_URL=http://localhost
# NGINX_HTTP_PORT=8088   # use if port 80 is taken by another product
# POSTGRES_HOST_PORT=5433  # use if 5432 is taken by another product
# REDIS_HOST_PORT=6380     # use if 6379 is taken by another product
# API_HOST_PORT=8080   # direct API link in Docker Desktop (optional; nginx also proxies /api/)
# WEB_HOST_PORT=3000   # direct web link in Docker Desktop (optional; prefer http://localhost via nginx)

# PostgreSQL (postgres service)
POSTGRES_DB=cohestra
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm

# API (api service) — override appsettings when running via Compose
# ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=cohestra;Username=crm;Password=crm
# ConnectionStrings__Redis=redis:6379
# ASPNETCORE_URLS=http://+:8080
# Jwt__SigningKey=dev-compose-jwt-signing-key-min-32-chars!!
# OperatorSeed__Email=operator@cohestra.local
# OperatorSeed__Password=ChangeMe123!
# Optional: set OperatorSeed__Enabled=true to auto-create an operator on first startup (skips /register onboarding).
# OperatorSeed__Enabled=false
# Platform admin console — /platform/login (Development only).
# PlatformAdminSeed__Enabled=false
# PlatformAdminSeed__Email=platform-admin@cohestra.local
# PlatformAdminSeed__Password=ChangeMe123!
# Optional: wipe + reseed production-like demo data on every API startup (Development only).
# Includes curated personas (Francis Decena, merge suspects, capacity-full activity, outreach timeline).
# DemoDataSeed__Enabled=true
# DemoDataSeed__ClientCount=48
# Load test workspaces — set Enabled=true, rebuild api, then login on the TENANT subdomain (not bare localhost):
#   http://load-core-alpha.localhost:8088/login
# LoadTestSeed__Enabled=true
# LoadTestSeed__ForceReseed=false
# LoadTestSeed__Password=LoadTest123!
# Tip: for all manual test profiles at once, copy .env.local-docker.example → .env

# SendGrid (api service) — set SendGrid__ApiKey in .env (never commit the key)
# After creating or rotating a key, replace the FULL secret below and recreate the API container:
#   docker compose up -d --force-recreate api
# Editing permissions on an existing SendGrid key does NOT change the secret — create a new key if needed.
# SendGrid__ApiKey=your-sendgrid-api-key
# SendGrid__FromEmail=noreply@cohestra.app
# SendGrid__FromName=Cohestra
# SendGrid__RegistrationFromEmail=noreply@cohestra.app
# SendGrid__RegistrationFromName=Cohestra
# SendGrid__UseSandbox=false
# EmailBranding__WebsiteUrl=https://cohestra.app
# EmailBranding__FooterLegalName=Cohestra
# EmailBranding__LogoUrl=https://your-domain.com/brand/cohestra-logo-email.png

# Landing page defaults (web build args + API SiteLanding seed)
# LANDING_SITE_NAME=Cohestra
# LANDING_TAGLINE=Community events. Meaningful connections.
# LANDING_EYEBROW=Community events platform

# Web (web service) — browser uses PUBLIC_BASE_URL via nginx; SSR uses internal API_URL
# NEXT_PUBLIC_API_URL is set from PUBLIC_BASE_URL at build time in docker-compose.yml
# API_URL=http://api:8080

# Paddle Billing (api service) — sandbox keys only; never commit live keys
# Paddle__ApiKey=pdl_sdbx_apikey_…
# Paddle__ClientToken=test_…
# Paddle__WebhookSecret=…
# Paddle__Environment=sandbox
# Paddle__PriceCoreMonthly=pri_…
# Paddle__PriceCoreAnnual=pri_…
# Paddle__PriceProMonthly=pri_…
# Paddle__PriceProAnnual=pri_…
# Paddle__TrialPeriodDays=30

# Self-serve signup — reCAPTCHA (required before public launch)
# Launch overlay enables reCAPTCHA by default (keeps Development env for local Docker):
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
# True production also requires in .env:
#   ASPNETCORE_ENVIRONMENT=Production
#   Jwt__SigningKey=<strong secret — not the dev-compose default>
#   POSTGRES_PASSWORD=<strong secret — not "crm">
# Enable on UAT/production BEFORE opening apex signup to the internet.
# After changing web vars, rebuild web: docker compose build web --no-cache && docker compose up -d web
# SelfServeSignup__Recaptcha__Enabled=true
# SelfServeSignup__Recaptcha__SecretKey=your-recaptcha-secret
# SelfServeSignup__Recaptcha__TestBypassToken=test-captcha-pass   # dev/UAT only when Enabled=false
# NEXT_PUBLIC_RECAPTCHA_ENABLED=true
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
# NEXT_PUBLIC_RECAPTCHA_TEST_TOKEN=test-captcha-pass              # dev/UAT only when NEXT_PUBLIC_RECAPTCHA_ENABLED=false
# See docs/deploy/cloud-mobile-testing.md and docs/deploy/enterprise-launch-checklist.md

# Local tenant routing — DEV_TENANT_SLUG (api service only)
# Optional override: maps plain localhost/apex to a tenant slug when you cannot use {slug}.localhost.
# By default, bare http://localhost:8088/ shows the marketing landing (same as cohestra.app).
# Example: DEV_TENANT_SLUG=default on api → http://localhost:8088/ resolves default tenant instead.
# DO NOT set in production — use real subdomains (*.cohestra.app) instead.
# DEV_TENANT_SLUG=default
